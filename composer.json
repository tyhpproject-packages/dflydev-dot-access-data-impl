{
    "name": "tyhpdef/dflydev-dot-access-data-impl",
    "description": "Implementation package for tyhpdef/dflydev-dot-access-data. Require tyhpdef/dflydev-dot-access-data, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "3.0.3.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/dflydev-dot-access-data"
        }
    },
    "require": {
        "php": ">=8.2",
        "dflydev/dot-access-data": "3.0.3"
    },
    "require-dev": {
        "tyhpdef/php": "@dev"
    }
}
